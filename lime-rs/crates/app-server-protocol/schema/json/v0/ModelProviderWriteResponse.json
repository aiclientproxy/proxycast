            "type": "string"
          },
          "type": "array"
        },
        "runtimeFeatures": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "taskFamilies": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
