        },
        {
          "properties": {
            "days": {
              "items": {
                "$ref": "#/$defs/ScheduledTaskWeekday"
              },
              "type": "array"
            },
            "time": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "weekly",
              "type": "string"
            }
          },
          "required": [
            "days",
            "time",
            "timezone",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ScheduledTaskSummary": {
      "properties": {
        "attention": {
