          ],
          "type": "object"
        },
        {
          "properties": {
            "time": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "daily",
              "type": "string"
            }
          },
          "required": [
            "time",
            "timezone",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "time": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "weekdays",
              "type": "string"
            }
