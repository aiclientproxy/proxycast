                "null"
              ]
            },
            "intervalHours": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "minute": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "hourly",
