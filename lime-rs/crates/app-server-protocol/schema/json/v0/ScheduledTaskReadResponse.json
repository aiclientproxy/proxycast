{
  "$defs": {
    "ScheduledTask": {
      "properties": {
        "createdAt": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        },
        "execution": {
          "$ref": "#/$defs/ScheduledTaskExecution"
        },
        "id": {
          "type": "string"
        },
        "lastRunSummary": {
          "anyOf": [
            {
              "$ref": "#/$defs/ScheduledTaskRunSummary"
            },
            {
              "type": "null"
            }
          ]
        },
        "nextRunAt": {
          "type": [
            "null",
            "string"
          ]
        },
        "notificationPolicy": {
          "$ref": "#/$defs/ScheduledTaskNotificationPolicy"
        },
        "overlapPolicy": {
          "$ref": "#/$defs/ScheduledTaskOverlapPolicy"
        },
        "prompt": {
          "type": "string"
        },
        "schedule": {
          "$ref": "#/$defs/ScheduledTaskSchedule"
        },
        "title": {
          "type": "string"
        },
        "updatedAt": {
          "type": "string"
        }
      },
      "required": [
        "createdAt",
        "enabled",
        "execution",
        "id",
        "notificationPolicy",
        "overlapPolicy",
        "prompt",
        "schedule",
        "title",
        "updatedAt"
      ],
      "type": "object"
    },
    "ScheduledTaskExecution": {
      "properties": {
        "approvalPolicy": true,
        "cwd": {
          "type": [
            "null",
            "string"
          ]
        },
        "modelId": {
          "type": [
            "null",
            "string"
          ]
        },
        "projectId": {
          "type": [
            "null",
            "string"
          ]
        },
        "reasoningEffort": {
          "type": [
            "null",
            "string"
          ]
        },
        "requestMetadata": true,
        "sandboxPolicy": true,
        "sourceThreadId": {
          "type": [
            "null",
            "string"
          ]
        },
        "threadMode": {
          "$ref": "#/$defs/ScheduledTaskThreadMode"
        }
      },
      "required": [
        "threadMode"
      ],
      "type": "object"
    },
    "ScheduledTaskNotificationPolicy": {
      "enum": [
        "all_runs",
        "failures",
        "none"
      ],
      "type": "string"
    },
    "ScheduledTaskOverlapPolicy": {
      "enum": [
        "skip_if_running"
      ],
      "type": "string"
    },
    "ScheduledTaskRunSummary": {
      "properties": {
        "error": {
          "type": [
            "null",
            "string"
          ]
        },
        "finishedAt": {
          "type": [
            "null",
            "string"
          ]
        },
        "id": {
          "type": "string"
        },
        "scheduledFor": {
          "type": [
            "null",
            "string"
          ]
        },
        "sessionId": {
          "type": [
            "null",
            "string"
          ]
        },
        "startedAt": {
          "type": [
            "null",
            "string"
          ]
        },
        "status": {
          "type": "string"
        },
        "summary": {
          "type": [
            "null",
            "string"
          ]
        },
        "taskId": {
          "type": "string"
        },
        "threadId": {
          "type": [
            "null",
            "string"
          ]
        },
        "turnId": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "id",
        "status",
        "taskId"
      ],
      "type": "object"
    },
    "ScheduledTaskSchedule": {
      "oneOf": [
        {
          "properties": {
            "days": {
              "items": {
                "$ref": "#/$defs/ScheduledTaskWeekday"
              },
              "type": [
                "array",
                "null"
              ]
            },
            "intervalHours": {
              "format": "uint32",
              "minimum": 0,
              "type": "integer"
            },
            "minute": {
              "format": "uint8",
              "maximum": 255,
              "minimum": 0,
              "type": "integer"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "hourly",
              "type": "string"
            }
          },
          "required": [
            "intervalHours",
            "minute",
            "timezone",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "time": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "daily",
              "type": "string"
            }
          },
          "required": [
            "time",
            "timezone",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "time": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "weekdays",
              "type": "string"
            }
          },
          "required": [
            "time",
            "timezone",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "days": {
              "items": {
                "$ref": "#/$defs/ScheduledTaskWeekday"
              },
              "type": "array"
            },
            "time": {
              "type": "string"
            },
            "timezone": {
              "type": "string"
            },
            "type": {
              "const": "weekly",
              "type": "string"
            }
          },
          "required": [
            "days",
            "time",
            "timezone",
            "type"
          ],
          "type": "object"
        }
      ]
    },
    "ScheduledTaskThreadMode": {
      "enum": [
        "continue_thread",
        "new_thread"
      ],
      "type": "string"
    },
    "ScheduledTaskWeekday": {
      "enum": [
        "FR",
        "MO",
        "SA",
        "SU",
        "TH",
        "TU",
        "WE"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "task": {
      "anyOf": [
        {
          "$ref": "#/$defs/ScheduledTask"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "title": "ScheduledTaskReadResponse",
  "type": "object"
}
