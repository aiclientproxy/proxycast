{
  "$defs": {
    "SkillAuthority": {
      "enum": [
        "application",
        "external",
        "user",
        "workspace"
      ],
      "type": "string"
    },
    "SkillDetailDependencies": {
      "properties": {
        "tools": {
          "items": {
            "$ref": "#/$defs/SkillDetailToolDependency"
          },
          "type": "array"
        }
      },
      "required": [
        "tools"
      ],
      "type": "object"
    },
    "SkillDetailInterface": {
      "properties": {
        "argumentHint": {
          "type": [
            "null",
            "string"
          ]
        },
        "displayName": {
          "type": "string"
        },
        "executionMode": {
          "type": "string"
        },
        "model": {
          "type": [
            "null",
            "string"
          ]
        },
        "provider": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "displayName",
        "executionMode"
      ],
      "type": "object"
    },
    "SkillDetailScope": {
      "enum": [
        "app",
        "other",
        "project",
        "user"
      ],
      "type": "string"
    },
    "SkillDetailToolDependency": {
      "properties": {
        "required": {
          "type": "boolean"
        },
        "type": {
          "type": "string"
        },
        "value": {
          "type": "string"
        }
      },
      "required": [
        "required",
        "type",
        "value"
      ],
      "type": "object"
    },
    "SkillLocator": {
      "properties": {
        "directory": {
          "type": "string"
        },
        "skillFilePath": {
          "type": "string"
        }
      },
      "required": [
        "directory",
        "skillFilePath"
      ],
      "type": "object"
    },
    "SkillPolicy": {
      "properties": {
        "allowImplicitInvocation": {
          "type": "boolean"
        },
        "whenToUse": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "allowImplicitInvocation"
      ],
      "type": "object"
    },
    "SkillSource": {
      "enum": [
        "app",
        "other",
        "project",
        "user"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "authority": {
      "$ref": "#/$defs/SkillAuthority"
    },
    "capabilities": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "dependencies": {
      "$ref": "#/$defs/SkillDetailDependencies"
    },
    "description": {
      "type": "string"
    },
    "enabled": {
      "type": "boolean"
    },
    "interface": {
      "$ref": "#/$defs/SkillDetailInterface"
    },
    "locator": {
      "$ref": "#/$defs/SkillLocator"
    },
    "name": {
      "type": "string"
    },
    "policy": {
      "$ref": "#/$defs/SkillPolicy"
    },
    "scope": {
      "$ref": "#/$defs/SkillDetailScope"
    },
    "skillId": {
      "type": "string"
    },
    "source": {
      "$ref": "#/$defs/SkillSource"
    }
  },
  "required": [
    "authority",
    "capabilities",
    "dependencies",
    "description",
    "enabled",
    "interface",
    "locator",
    "name",
    "policy",
    "scope",
    "skillId",
    "source"
  ],
  "title": "SkillSummary",
  "type": "object"
}
