    "AppReview": {
      "properties": {
        "status": {
          "type": "string"
        }
      },
      "required": [
        "status"
      ],
      "type": "object"
    },
    "AppScreenshot": {
      "properties": {
        "fileId": {
          "type": [
            "null",
            "string"
          ]
        },
        "url": {
          "type": [
            "null",
            "string"
          ]
        },
        "userPrompt": {
          "type": "string"
        }
      },
      "required": [
        "userPrompt"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "categories": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "developer": {
      "type": [
        "null",
        "string"
      ]
    },
    "firstPartyRequiresInstall": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "review": {
