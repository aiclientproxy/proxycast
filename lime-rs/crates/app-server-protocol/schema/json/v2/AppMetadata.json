      },
      "type": [
        "array",
        "null"
      ]
    },
    "seoDescription": {
      "type": [
        "null",
        "string"
      ]
    },
    "showInComposerWhenUnlinked": {
      "type": [
        "boolean",
        "null"
      ]
    },
    "subCategories": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "version": {
      "type": [
        "null",
        "string"
      ]
    },
    "versionId": {
      "type": [
        "null",
        "string"
      ]
    },
    "versionNotes": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "title": "AppMetadata",
  "type": "object"
}
