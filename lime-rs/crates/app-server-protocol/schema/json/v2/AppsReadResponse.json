            "null",
            "string"
          ]
        },
        "isEnabled": {
          "default": true,
          "type": "boolean"
        },
        "isReadOnly": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "title": {
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "description",
        "name"
      ],
      "type": "object"
    },
    "ConnectorMetadata": {
      "properties": {
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "distributionChannel": {
          "type": [
            "null",
            "string"
          ]
        },
        "iconUrl": {
          "type": [
            "null",
            "string"
          ]
        },
        "iconUrlDark": {
          "type": [
            "null",
            "string"
          ]
        },
        "id": {
          "type": "string"
        },
        "installUrl": {
          "type": [
            "null",
            "string"
          ]
        },
        "name": {
          "type": "string"
        },
        "pluginDisplayNames": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "toolSummaries": {
