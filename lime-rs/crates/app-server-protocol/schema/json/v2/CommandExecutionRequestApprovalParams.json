{
  "$defs": {
    "CommandExecutionApprovalDecision": {
      "enum": [
        "accept",
        "acceptForSession",
        "cancel",
        "decline"
      ],
      "type": "string"
    },
    "NetworkApprovalContext": {
      "properties": {
        "host": {
          "type": "string"
        },
        "protocol": {
          "$ref": "#/$defs/NetworkApprovalProtocol"
        }
      },
      "required": [
        "host",
        "protocol"
      ],
      "type": "object"
    },
    "NetworkApprovalProtocol": {
      "enum": [
        "http",
        "https",
        "socks5Tcp",
        "socks5Udp"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approvalId": {
      "type": [
        "null",
        "string"
      ]
    },
    "availableDecisions": {
      "items": {
        "$ref": "#/$defs/CommandExecutionApprovalDecision"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "command": {
      "type": [
        "null",
        "string"
      ]
    },
    "cwd": {
      "type": [
        "null",
        "string"
      ]
    },
    "itemId": {
      "type": "string"
    },
    "networkApprovalContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/NetworkApprovalContext"
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "type": [
        "null",
        "string"
      ]
    },
    "startedAtMs": {
      "format": "int64",
      "type": "integer"
    },
    "threadId": {
      "type": "string"
    },
    "turnId": {
      "type": "string"
    }
  },
  "required": [
    "itemId",
    "startedAtMs",
    "threadId",
    "turnId"
  ],
  "title": "CommandExecutionRequestApprovalParams",
  "type": "object"
}
