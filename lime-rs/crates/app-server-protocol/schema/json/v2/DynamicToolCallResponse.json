{
  "$defs": {
    "DynamicToolCallApproval": {
      "properties": {
        "actionKind": {
          "type": "string"
        },
        "approvalToken": {
          "type": "string"
        },
        "backendNodeId": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "browserSessionId": {
          "type": "string"
        },
        "reason": {
          "type": "string"
        },
        "riskClass": {
          "type": "string"
        },
        "snapshotId": {
          "type": "string"
        },
        "tabId": {
          "type": "string"
        },
        "viewId": {
          "type": "string"
        },
        "webContentsId": {
          "format": "uint64",
          "minimum": 0,
          "type": "integer"
        }
      },
      "required": [
        "actionKind",
        "approvalToken",
        "browserSessionId",
        "reason",
        "riskClass",
        "snapshotId",
        "tabId",
        "viewId",
        "webContentsId"
      ],
      "type": "object"
    },
    "DynamicToolCallOutputContentItem": {
      "oneOf": [
        {
          "properties": {
            "text": {
              "type": "string"
            },
            "type": {
              "const": "inputText",
              "type": "string"
            }
          },
          "required": [
            "text",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "imageUrl": {
              "type": "string"
            },
            "type": {
              "const": "inputImage",
              "type": "string"
            }
          },
          "required": [
            "imageUrl",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "audioUrl": {
              "type": "string"
            },
            "type": {
              "const": "inputAudio",
              "type": "string"
            }
          },
          "required": [
            "audioUrl",
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approval": {
      "anyOf": [
        {
          "$ref": "#/$defs/DynamicToolCallApproval"
        },
        {
          "type": "null"
        }
      ]
    },
    "contentItems": {
      "items": {
        "$ref": "#/$defs/DynamicToolCallOutputContentItem"
      },
      "type": "array"
    },
    "success": {
      "type": "boolean"
    }
  },
  "required": [
    "contentItems",
    "success"
  ],
  "title": "DynamicToolCallResponse",
  "type": "object"
}
