        "beta",
        "deprecated",
        "removed",
        "stable",
        "underDevelopment"
      ],
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Response for `experimentalFeature/list`.",
  "properties": {
    "data": {
      "items": {
        "$ref": "#/$defs/ExperimentalFeature"
      },
      "type": "array"
    },
    "nextCursor": {
      "type": [
        "null",
        "string"
      ]
    }
  },
  "required": [
    "data"
  ],
  "title": "ExperimentalFeatureListResponse",
  "type": "object"
}
