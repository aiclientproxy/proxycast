{
  "$defs": {
    "ExperimentalFeature": {
      "description": "Feature metadata and current enablement state.",
      "properties": {
        "announcement": {
          "type": [
            "null",
            "string"
          ]
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "description": {
          "type": [
            "null",
            "string"
          ]
        },
        "displayName": {
          "type": [
            "null",
            "string"
          ]
        },
        "enabled": {
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "stage": {
          "$ref": "#/$defs/ExperimentalFeatureStage"
        }
      },
      "required": [
        "defaultEnabled",
        "enabled",
        "name",
        "stage"
      ],
      "type": "object"
    },
    "ExperimentalFeatureStage": {
      "description": "Codex-compatible lifecycle stage for an experimental feature.",
