        "imported": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "importedIncomplete": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "importedReadOnly": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "importedSynthetic": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "importedSyntheticId": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "sourceCallId": {
          "type": [
            "null",
            "string"
          ]
        },
        "sourceClient": {
          "type": [
            "null",
            "string"
          ]
        },
        "sourceEventSeq": {
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "sourceEventType": {
          "type": [
            "null",
            "string"
          ]
        },
        "sourceProvenance": {
