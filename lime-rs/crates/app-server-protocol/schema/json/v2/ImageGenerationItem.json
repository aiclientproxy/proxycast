{
  "$defs": {
    "ThreadItemMetadata": {
      "description": "Safe, display-only provenance carried by imported historical items.\n\nThe canonical store keeps richer metadata, but only these stable markers\ncross the v2 boundary. In particular, raw source payloads and capabilities\nare intentionally excluded.",
