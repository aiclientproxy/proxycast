{
  "$defs": {
    "PluginAuthPolicy": {
      "enum": [
        "ON_INSTALL",
        "ON_USE"
      ],
      "type": "string"
    },
    "PluginAvailability": {
      "enum": [
        "AVAILABLE",
        "DISABLED_BY_ADMIN"
      ],
      "type": "string"
    },
    "PluginDisabledReason": {
      "enum": [
        "disabled_by_admin",
        "plan_not_eligible",
        "required_app_unavailable",
        "unknown"
      ],
      "type": "string"
    },
    "PluginInstallPolicy": {
      "enum": [
        "AVAILABLE",
        "INSTALLED_BY_DEFAULT",
        "NOT_AVAILABLE"
      ],
      "type": "string"
    },
    "PluginInstallPolicySource": {
      "enum": [
        "IMPLICIT_CANONICAL_APP",
        "WORKSPACE_SETTING"
      ],
      "type": "string"
    },
    "PluginInterface": {
      "properties": {
        "brandColor": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "capabilities": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "category": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "composerIcon": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "composerIconUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "defaultPrompt": {
          "default": null,
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "developerName": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "displayName": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logo": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logoDark": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logoUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "logoUrlDark": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "longDescription": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "privacyPolicyUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "screenshotUrls": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "screenshots": {
          "default": [],
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        "shortDescription": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "termsOfServiceUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "websiteUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        }
      },
      "type": "object"
    },
    "PluginShareContext": {
      "properties": {
        "canPublishToWorkspace": {
          "default": null,
          "type": [
            "boolean",
            "null"
          ]
        },
        "creatorAccountUserId": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "creatorName": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "discoverability": {
          "anyOf": [
            {
              "$ref": "#/$defs/PluginShareDiscoverability"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "remotePluginId": {
          "type": "string"
        },
        "remoteVersion": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "sharePrincipals": {
          "default": null,
          "items": {
            "$ref": "#/$defs/PluginSharePrincipal"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "shareUrl": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "remotePluginId"
      ],
      "type": "object"
    },
    "PluginShareDiscoverability": {
      "enum": [
        "LISTED",
        "PRIVATE",
        "UNLISTED"
      ],
      "type": "string"
    },
    "PluginSharePrincipal": {
      "properties": {
        "name": {
          "type": "string"
        },
        "principalId": {
          "type": "string"
        },
        "principalType": {
          "$ref": "#/$defs/PluginSharePrincipalType"
        },
        "role": {
          "$ref": "#/$defs/PluginSharePrincipalRole"
        }
      },
      "required": [
        "name",
        "principalId",
        "principalType",
        "role"
      ],
      "type": "object"
    },
    "PluginSharePrincipalRole": {
      "enum": [
        "editor",
        "owner",
        "reader"
      ],
      "type": "string"
    },
    "PluginSharePrincipalType": {
      "enum": [
        "group",
        "user",
        "workspace"
      ],
      "type": "string"
    },
    "PluginSource": {
      "oneOf": [
        {
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "local",
              "type": "string"
            }
          },
          "required": [
            "path",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "path": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "refName": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "sha": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "const": "git",
              "type": "string"
            },
            "url": {
              "type": "string"
            }
          },
          "required": [
            "type",
            "url"
          ],
          "type": "object"
        },
        {
          "properties": {
            "package": {
              "type": "string"
            },
            "registry": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            },
            "type": {
              "const": "npm",
              "type": "string"
            },
            "version": {
              "default": null,
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "package",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "remote",
              "type": "string"
            }
          },
          "required": [
            "type"
          ],
          "type": "object"
        }
      ]
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "authPolicy": {
      "$ref": "#/$defs/PluginAuthPolicy"
    },
    "availability": {
      "$ref": "#/$defs/PluginAvailability",
      "default": "AVAILABLE"
    },
    "disabledReason": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginDisabledReason"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "eligiblePlanTypes": {
      "default": null,
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "enabled": {
      "type": "boolean"
    },
    "id": {
      "type": "string"
    },
    "installPolicy": {
      "$ref": "#/$defs/PluginInstallPolicy"
    },
    "installPolicySource": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginInstallPolicySource"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "installed": {
      "type": "boolean"
    },
    "installedAt": {
      "default": null,
      "format": "int64",
      "type": [
        "integer",
        "null"
      ]
    },
    "interface": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginInterface"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "keywords": {
      "default": [],
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "localVersion": {
      "default": null,
      "type": [
        "null",
        "string"
      ]
    },
    "mustShowInstallationInterstitial": {
      "default": null,
      "type": [
        "boolean",
        "null"
      ]
    },
    "name": {
      "type": "string"
    },
    "remotePluginId": {
      "default": null,
      "type": [
        "null",
        "string"
      ]
    },
    "shareContext": {
      "anyOf": [
        {
          "$ref": "#/$defs/PluginShareContext"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "source": {
      "$ref": "#/$defs/PluginSource"
    },
    "version": {
      "default": null,
      "type": [
        "null",
        "string"
      ]
    }
  },
  "required": [
    "authPolicy",
    "enabled",
    "id",
    "installPolicy",
    "installed",
    "name",
    "source"
  ],
  "title": "PluginSummary",
  "type": "object"
}
