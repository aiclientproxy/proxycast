{
  "$defs": {
    "AdditionalFileSystemPermissions": {
      "properties": {
        "entries": {
          "items": {
            "$ref": "#/$defs/FileSystemSandboxEntry"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "globScanMaxDepth": {
          "format": "uint",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "read": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "write": {
          "items": {
            "type": "string"
          },
          "type": [
            "array",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "AdditionalNetworkPermissions": {
      "properties": {
        "enabled": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "type": "object"
    },
    "CommandExecutionApprovalDecision": {
      "enum": [
        "accept",
        "acceptForSession",
        "cancel",
        "decline"
      ],
      "type": "string"
    },
    "CommandExecutionRequestApprovalParams": {
      "properties": {
        "approvalId": {
          "type": [
            "null",
            "string"
          ]
        },
        "availableDecisions": {
          "items": {
            "$ref": "#/$defs/CommandExecutionApprovalDecision"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "command": {
          "type": [
            "null",
            "string"
          ]
        },
        "cwd": {
          "type": [
            "null",
            "string"
          ]
        },
        "itemId": {
          "type": "string"
        },
        "reason": {
          "type": [
            "null",
            "string"
          ]
        },
        "startedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "startedAtMs",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "CurrentTimeReadParams": {
      "properties": {
        "threadId": {
          "type": "string"
        }
      },
      "required": [
        "threadId"
      ],
      "type": "object"
    },
    "DynamicToolCallParams": {
      "properties": {
        "arguments": true,
        "callId": {
          "type": "string"
        },
        "namespace": {
          "type": [
            "null",
            "string"
          ]
        },
        "threadId": {
          "type": "string"
        },
        "tool": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "arguments",
        "callId",
        "threadId",
        "tool",
        "turnId"
      ],
      "type": "object"
    },
    "FileChangeRequestApprovalParams": {
      "properties": {
        "grantRoot": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "itemId": {
          "type": "string"
        },
        "reason": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "startedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "startedAtMs",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "FileSystemAccessMode": {
      "enum": [
        "deny",
        "read",
        "write"
      ],
      "type": "string"
    },
    "FileSystemPath": {
      "oneOf": [
        {
          "properties": {
            "path": {
              "type": "string"
            },
            "type": {
              "const": "path",
              "type": "string"
            }
          },
          "required": [
            "path",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "pattern": {
              "type": "string"
            },
            "type": {
              "const": "glob_pattern",
              "type": "string"
            }
          },
          "required": [
            "pattern",
            "type"
          ],
          "type": "object"
        },
        {
          "properties": {
            "type": {
              "const": "special",
              "type": "string"
            },
            "value": {
              "$ref": "#/$defs/FileSystemSpecialPath"
            }
          },
          "required": [
            "type",
            "value"
          ],
          "type": "object"
        }
      ]
    },
    "FileSystemSandboxEntry": {
      "properties": {
        "access": {
          "$ref": "#/$defs/FileSystemAccessMode"
        },
        "path": {
          "$ref": "#/$defs/FileSystemPath"
        }
      },
      "required": [
        "access",
        "path"
      ],
      "type": "object"
    },
    "FileSystemSpecialPath": {
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "root",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "minimal",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "project_roots",
              "type": "string"
            },
            "subpath": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "tmpdir",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "slash_tmp",
              "type": "string"
            }
          },
          "required": [
            "kind"
          ],
          "type": "object"
        },
        {
          "properties": {
            "kind": {
              "const": "unknown",
              "type": "string"
            },
            "path": {
              "type": "string"
            },
            "subpath": {
              "type": [
                "null",
                "string"
              ]
            }
          },
          "required": [
            "kind",
            "path"
          ],
          "type": "object"
        }
      ]
    },
    "McpServerElicitationRequestParams": {
      "oneOf": [
        {
          "properties": {
            "_meta": {
              "default": null
            },
            "message": {
              "minLength": 1,
              "type": "string"
            },
            "mode": {
              "const": "form",
              "type": "string"
            },
            "requestedSchema": {
              "additionalProperties": true,
              "type": "object"
            }
          },
          "required": [
            "message",
            "mode",
            "requestedSchema"
          ],
          "type": "object"
        }
      ],
      "properties": {
        "serverName": {
          "minLength": 1,
          "type": "string"
        },
        "threadId": {
          "minLength": 1,
          "type": "string"
        },
        "turnId": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        }
      },
      "required": [
        "serverName",
        "threadId"
      ],
      "type": "object"
    },
    "PermissionsRequestApprovalParams": {
      "properties": {
        "cwd": {
          "type": "string"
        },
        "environmentId": {
          "default": null,
          "type": [
            "null",
            "string"
          ]
        },
        "itemId": {
          "type": "string"
        },
        "permissions": {
          "$ref": "#/$defs/RequestPermissionProfile"
        },
        "reason": {
          "type": [
            "null",
            "string"
          ]
        },
        "startedAtMs": {
          "format": "int64",
          "type": "integer"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "cwd",
        "itemId",
        "permissions",
        "startedAtMs",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "RequestId": {
      "anyOf": [
        {
          "format": "int64",
          "type": "integer"
        },
        {
          "type": "string"
        }
      ]
    },
    "RequestPermissionProfile": {
      "additionalProperties": false,
      "properties": {
        "fileSystem": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdditionalFileSystemPermissions"
            },
            {
              "type": "null"
            }
          ]
        },
        "network": {
          "anyOf": [
            {
              "$ref": "#/$defs/AdditionalNetworkPermissions"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "type": "object"
    },
    "ToolRequestUserInputOption": {
      "properties": {
        "description": {
          "type": "string"
        },
        "label": {
          "type": "string"
        }
      },
      "required": [
        "description",
        "label"
      ],
      "type": "object"
    },
    "ToolRequestUserInputParams": {
      "properties": {
        "autoResolutionMs": {
          "default": null,
          "format": "uint64",
          "minimum": 0,
          "type": [
            "integer",
            "null"
          ]
        },
        "itemId": {
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/ToolRequestUserInputQuestion"
          },
          "type": "array"
        },
        "threadId": {
          "type": "string"
        },
        "turnId": {
          "type": "string"
        }
      },
      "required": [
        "itemId",
        "questions",
        "threadId",
        "turnId"
      ],
      "type": "object"
    },
    "ToolRequestUserInputQuestion": {
      "properties": {
        "header": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "isOther": {
          "default": false,
          "type": "boolean"
        },
        "isSecret": {
          "default": false,
          "type": "boolean"
        },
        "options": {
          "items": {
            "$ref": "#/$defs/ToolRequestUserInputOption"
          },
          "type": [
            "array",
            "null"
          ]
        },
        "question": {
          "type": "string"
        }
      },
      "required": [
        "header",
        "id",
        "question"
      ],
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Requests initiated by the server and sent to a v2 client. Unknown methods\nfail closed until their typed params and response contracts are added.",
  "oneOf": [
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "currentTime/read",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/CurrentTimeReadParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "mcpServer/elicitation/request",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/McpServerElicitationRequestParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "item/commandExecution/requestApproval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/CommandExecutionRequestApprovalParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "item/fileChange/requestApproval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/FileChangeRequestApprovalParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "item/permissions/requestApproval",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/PermissionsRequestApprovalParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "item/tool/call",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/DynamicToolCallParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    },
    {
      "properties": {
        "id": {
          "$ref": "#/$defs/RequestId"
        },
        "method": {
          "const": "item/tool/requestUserInput",
          "type": "string"
        },
        "params": {
          "$ref": "#/$defs/ToolRequestUserInputParams"
        }
      },
      "required": [
        "id",
        "method",
        "params"
      ],
      "type": "object"
    }
  ],
  "title": "ServerRequest"
}
