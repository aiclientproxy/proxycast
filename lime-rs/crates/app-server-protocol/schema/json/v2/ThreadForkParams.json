{
  "$defs": {
    "ThreadSource": {
      "description": "Analytics source classification for a thread.\n\nCodex keeps feature values open-ended while preserving a typed wire shape;\nthe same representation avoids a public untyped string field in Lime.",
      "type": "string"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "properties": {
    "approvalPolicy": true,
    "approvalsReviewer": true,
    "baseInstructions": {
      "type": [
        "null",
        "string"
      ]
    },
    "beforeTurnId": {
      "type": [
        "null",
        "string"
      ]
    },
    "config": {
      "additionalProperties": true,
      "type": [
        "null",
        "object"
      ]
    },
    "cwd": {
      "type": [
        "null",
        "string"
      ]
    },
    "deferGoalContinuation": {
      "type": "boolean"
    },
    "developerInstructions": {
      "type": [
        "null",
        "string"
      ]
    },
    "ephemeral": {
      "type": "boolean"
    },
    "excludeTurns": {
      "type": "boolean"
    },
    "lastTurnId": {
      "type": [
        "null",
        "string"
      ]
    },
    "model": {
      "type": [
        "null",
        "string"
      ]
    },
    "modelProvider": {
      "type": [
        "null",
        "string"
      ]
    },
    "path": {
      "type": [
        "null",
        "string"
      ]
    },
    "permissions": {
      "type": [
        "null",
        "string"
      ]
    },
    "runtimeWorkspaceRoots": {
      "items": {
        "type": "string"
      },
      "type": [
        "array",
        "null"
      ]
    },
    "sandbox": true,
    "serviceTier": {
      "type": [
        "null",
        "string"
      ]
    },
    "threadId": {
      "type": "string"
    },
    "threadSource": {
      "anyOf": [
        {
          "$ref": "#/$defs/ThreadSource"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "threadId"
  ],
  "title": "ThreadForkParams",
  "type": "object"
}
