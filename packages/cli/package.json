{
  "name": "@limecloud/lime",
  "version": "1.140.0",
  "description": "Lime CLI is an agent that runs in your terminal.",
  "bin": {
    "lime": "scripts/run.js"
  },
  "scripts": {
    "postinstall": "node scripts/install.js",
    "build:release": "node scripts/build-release.js"
